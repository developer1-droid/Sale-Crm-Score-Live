# Copy this file to .env and fill in the values.

# Deployed CRM
CRM_BASE_URL=https://shazia-rice-pi-app.vercel.app

# Same values as the CRM's NEXT_PUBLIC_FIREBASE_API_KEY / NEXT_PUBLIC_FIREBASE_PROJECT_ID
FIREBASE_API_KEY="AIzaSyBk4Hk-x4Vpq6fac-RgFQKr93h2CQQWikY"

FIREBASE_PROJECT_ID="crm-app-7f8fe"


# CRM login used by the TV server (email + password, same as the CRM login page).
# Use an account with Super Admin, or with dept_analytics.view.all + sales_report.view.all,
# otherwise the Sales Report only returns that user's own row.
CRM_EMAIL=ankit@shaziarice.com
CRM_PASSWORD=Ankitcrm@0013

# How often to pull fresh data from the CRM (seconds). The data comes from Google Sheets,
# so keep this at 60 or more to avoid quota problems.
POLL_SECONDS=60

# Port the TV page is served on: http://localhost:4000
PORT=4000
